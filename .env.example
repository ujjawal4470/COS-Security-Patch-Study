# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here

# Database
DATABASE_PATH=./backend/data/cos_study.db

# GCP Configuration (for live scanning)
GCP_PROJECT=your-gcp-project-id
GCP_ZONE=us-central1-a
GCP_INSTANCE=cos-study-vm

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
FRONTEND_PORT=3000
